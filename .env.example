APP_ENV=development
# Local Docker Compose database. For Render, use the Supabase Session Pooler URL
# and change the scheme to postgresql+psycopg:// (see README.md).
DATABASE_URL=postgresql+psycopg://golf_user:change_me@db:5432/ai_golf_caddie
POSTGRES_DB=ai_golf_caddie
POSTGRES_USER=golf_user
POSTGRES_PASSWORD=change_me

# Replace before deployment. Production startup requires a non-empty value.
JWT_SECRET_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# In the Render API service, set CORS_ORIGINS to the frontend origin only:
# https://ai-golf-caddie-web-77sj.onrender.com

# Optional integrations; keep server-side keys on the API, never in VITE_ values.
GOLF_API_KEY=
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.5-flash-lite
GOOGLE_FALLBACK_MODEL=gemini-3.1-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# Local frontend values.
VITE_API_BASE_URL=http://localhost:8000/api
# For the Render static site, set this to:
# https://ai-golf-caddie-api-77sj.onrender.com/api
# Local native iOS development uses the computer's reachable LAN address here.
VITE_MOBILE_API_URL=http://192.168.1.10:8000/api
# For a hosted iOS build, set VITE_MOBILE_API_URL to the hosted API URL above,
# then rebuild/sync and reinstall the native app.
VITE_MAPBOX_TOKEN=
# VITE_MAPBOX_ACCESS_TOKEN is also accepted for compatibility with older local env files.
